# Optional live grid feed. If omitted, deterministic mock/diurnal telemetry is used.
ELECTRICITY_MAPS_API_KEY=
ELECTRICITY_MAPS_API_VERSION=v4

# Optional natural-language command enhancement via Groq. Without a key, a deterministic parser is used.
# Create a key at https://console.groq.com/keys and pick any chat model id from https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional second (backup) Groq key. If the primary fails (rate limit, bad key, timeout) the backup is tried automatically.
GROQ_API_KEY_2=
# Optional model for the backup key (defaults to GROQ_MODEL).
GROQ_MODEL_2=
# failover = primary first, backup only on failure (default). balance = alternate keys per request to spread rate limits.
GROQ_STRATEGY=failover

# Local Qiskit simulator tuning.
QUANTUM_MAX_CANDIDATES=6
QUANTUM_PARAMETER_GRID=3
QUANTUM_SHOTS=512
QUANTUM_ONE_HOT_PENALTY=8.0

# Production uses the bounded Node CPU simulator; Python is local-only.

# Local Next.js + Qiskit helper mode. start-local.bat sets these automatically.
NEXT_PUBLIC_QUANTUM_LOCAL=
QUANTUM_LOCAL_PYTHON_URL=http://127.0.0.1:8765
QUANTUM_LOCAL_PORT=8765

# Select onnx (default) or glpk to bypass native ONNX on restricted hosting
ENGINE_DEFAULT=onnx
# Optional override for model-health diagnostics
# ONNX_MODEL_PATH=/absolute/path/to/model.onnx

QUANTUM_REPS=1
QUANTUM_CANDIDATE_MODE=topk
# Live runtime guard rejects >10 qubits or p>2.

# Optional CPU/GPU cloud QAOA service; server-side only
CLOUD_QAOA_URL=
CLOUD_QAOA_API_KEY=
