{
  "name": "dual-engine-carbon-treasury-controller",
  "version": "5.0.0",
  "private": true,
  "description": "Dynamic simulation-driven dual-engine carbon and treasury controller.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts",
    "model:build": "python3 scripts/build_onnx_model.py",
    "model:qaoa-labels": "python3 -m qiskit_train.qiskit_qaoa --samples 32",
    "model:train-qiskit": "python3 -m qiskit_train.train_surrogate --labels qiskit_train/artifacts/qiskit_labels.jsonl --epochs 700",
    "quantum:python-check": "python3 -c \"import qiskit; print(qiskit.__version__)\""
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "clsx": "^2.1.1",
    "d3-sankey": "^0.12.3",
    "framer-motion": "^12.0.0",
    "glpk.js": "^4.0.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "onnxruntime-node": "^1.20.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "three": "^0.170.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "react-is": "^19.0.0"
  }
}
